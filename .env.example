# ==============================================================================
# Environment Configuration Template
# Copy this file to `.env` and populate with your deployed AWS resources.
# NEVER commit your actual `.env` file with secrets or credentials to git.
# ==============================================================================

# API Gateway base URL from CloudFormation stack outputs
# Format: https://{RestApiId}.execute-api.{Region}.amazonaws.com/dev/
API_BASE_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/dev/
VITE_API_BASE_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/dev/

# AWS Region where the SAM stack is deployed
AWS_REGION=us-east-1

# Stack Name used during `sam deploy --guided`
AWS_STACK_NAME=image-classifier-stack
