# ==============================================================================
# Git Ignore Configuration: Serverless Image Classifier
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets, Credentials, & Environment Variables (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.pkcs12
credentials
aws-credentials*
aws_credentials*

# ------------------------------------------------------------------------------
# AWS SAM CLI & CloudFormation Build Artifacts
# ------------------------------------------------------------------------------
.aws-sam/
samconfig.toml
packaged.yaml
*.template.yaml.out

# ------------------------------------------------------------------------------
# Python Virtual Environments, Bytecode, & Packages
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
ENV/
env/
*.whl

# ------------------------------------------------------------------------------
# Testing, Coverage, & Cache
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
*.cover
nosetests.xml
htmlcov/
.tox/
.nox/
scratch/

# ------------------------------------------------------------------------------
# Node.js / Frontend Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
package-lock.json

# ------------------------------------------------------------------------------
# IDE & Operating System Artifacts
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
